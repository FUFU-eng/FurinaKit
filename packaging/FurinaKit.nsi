  SetOutPath "$INSTDIR"
  WriteUninstaller "$INSTDIR\Uninstall FurinaKit.exe"

  ; Create Shortcuts
  CreateDirectory "$SMPROGRAMS\FurinaKit"
  CreateShortcut "$SMPROGRAMS\FurinaKit\FurinaKit.lnk" "$INSTDIR\FurinaKit.exe" "" "$INSTDIR\FurinaKit.exe" 0
  CreateShortcut "$DESKTOP\FurinaKit.lnk" "$INSTDIR\FurinaKit.exe" "" "$INSTDIR\FurinaKit.exe" 0

  ; Add/Remove Programs Registry Keys
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\furinakit" "DisplayName" "FurinaKit 芙宁娜工具箱"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\furinakit" "DisplayVersion" "2.1.0"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\furinakit" "Publisher" "FUFU-eng"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\furinakit" "InstallLocation" "$INSTDIR"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\furinakit" "DisplayIcon" "$INSTDIR\FurinaKit.exe,0"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\furinakit" "UninstallString" '$\"$INSTDIR\Uninstall FurinaKit.exe$\"'
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\furinakit" "QuietUninstallString" '$\"$INSTDIR\Uninstall FurinaKit.exe$\" /S'
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\furinakit" "URLInfoAbout" "https://github.com/FUFU-eng/FurinaKit"
  WriteRegDWORD HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\furinakit" "EstimatedSize" ${INSTALLED_SIZE_KB}
  WriteRegDWORD HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\furinakit" "NoModify" 1
  WriteRegDWORD HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\furinakit" "NoRepair" 1

  Call MigrateLegacyAutostart
SectionEnd

Function un.onInit
  SetShellVarContext current
check_un_again:
  System::Call 'kernel32::OpenMutexW(i 0x00100000, i 0, w "furinakit-single-instance-normal") p.r0'
  ${If} $0 != 0
    System::Call 'kernel32::CloseHandle(p r0)'
    MessageBox MB_RETRYCANCEL|MB_ICONEXCLAMATION "请先从托盘退出 FurinaKit，再进行卸载。" IDRETRY check_un_again
    SetErrorLevel 2
    Abort
  ${EndIf}
FunctionEnd

Section "Uninstall"
  SetRegView 32
  ReadRegStr $0 HKCU "Software\ElcomSoft\Common Files" "Location"
  StrCmp $0 "$INSTDIR\tools\archpr" 0 archpr_shared_cleanup_done
    DeleteRegValue HKCU "Software\ElcomSoft\Common Files" "Location"
    DeleteRegKey /ifempty HKCU "Software\ElcomSoft\Common Files"
  archpr_shared_cleanup_done:
  SetRegView lastused

  Delete "$INSTDIR\DIRECTML-LICENSE.txt"
