!insertmacro MUI_LANGUAGE "English"


; ── 旧版 2.0.6（Electron）接管 ──────────────────────────────────────────
; electron-builder 用 appId com.furinakit.app 生成的卸载键
!define LEGACY_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\833dcdcd-48d4-5f29-89e5-b4d81593dd90"
!define RUN_KEY "Software\Microsoft\Windows\CurrentVersion\Run"
Var LegacyUninst
Var LegacyDir
Var LegacyAllUsers

; 从 UninstallString（形如 "X:\dir\Uninstall FurinaKit.exe" /currentuser）取出 exe 路径
Function LegacyParseUninst
  Exch $0
  Push $1
  Push $2
  Push $3
  StrCpy $1 $0 1
  ${If} $1 == '"'
    StrCpy $2 1
    loop_q:
      StrCpy $3 $0 1 $2
      ${If} $3 == ""
      ${OrIf} $3 == '"'
        Goto done_q
      ${EndIf}
      IntOp $2 $2 + 1
      Goto loop_q
    done_q:
    IntOp $2 $2 - 1
    StrCpy $0 $0 $2 1
  ${EndIf}
  Pop $3
  Pop $2
  Pop $1
  Exch $0
FunctionEnd

Function DetectLegacy
  StrCpy $LegacyUninst ""
  StrCpy $LegacyDir ""
  StrCpy $LegacyAllUsers "0"
  ReadRegStr $0 HKCU "${LEGACY_KEY}" "UninstallString"
  ${If} $0 == ""
    SetRegView 64
    ReadRegStr $0 HKLM "${LEGACY_KEY}" "UninstallString"
    ${If} $0 == ""
      SetRegView 32
      ReadRegStr $0 HKLM "${LEGACY_KEY}" "UninstallString"
    ${EndIf}
    SetRegView 32
    ${If} $0 != ""
      StrCpy $LegacyAllUsers "1"
    ${EndIf}
  ${EndIf}
  ${If} $0 == ""
    Return
  ${EndIf}
  Push $0
  Call LegacyParseUninst
  Pop $1
  ${IfNot} ${FileExists} "$1"
    ; 残留的注册表项（程序早已不在）：当前用户的顺手清掉
    ${If} $LegacyAllUsers == "0"
      DeleteRegKey HKCU "${LEGACY_KEY}"
    ${EndIf}
    Return
  ${EndIf}
  StrCpy $LegacyUninst $1
  ${GetParent} $1 $LegacyDir
FunctionEnd

Function RemoveLegacy
  ${If} $LegacyUninst == ""
    Return
  ${EndIf}
  ${If} $LegacyAllUsers == "1"
    MessageBox MB_YESNO|MB_ICONQUESTION "检测到旧版 FurinaKit 2.0.6（为所有用户安装在 $LegacyDir）。$\r$\n$\r$\n是否现在卸载旧版，释放约 600 MB 空间？$\r$\n（需要管理员确认；你的设置、收藏等数据会保留并自动导入新版）" /SD IDNO IDYES do_remove_all
    Return
    do_remove_all:
    DetailPrint "正在卸载旧版 FurinaKit 2.0.6…"
    ExecWait '"$LegacyUninst" /S /allusers _?=$LegacyDir' $0
    Delete "$LegacyUninst"
    RMDir "$LegacyDir"
    Return
  ${EndIf}
  ; 当前用户安装（默认情况）：等旧版退出后静默卸载（旧版数据保留，新版首次启动时自动导入）
  DetailPrint "正在移除旧版 FurinaKit 2.0.6（设置、收藏等数据会保留）…"
  StrCpy $1 0
  wait_old:
    ClearErrors
    FileOpen $2 "$LegacyDir\FurinaKit.exe" a
    ${IfNot} ${Errors}
      FileClose $2
      Goto old_closed
    ${EndIf}
    IntOp $1 $1 + 1
    ${If} $1 > 20
      Goto old_closed
    ${EndIf}
    Sleep 500
    Goto wait_old
  old_closed:
  ExecWait '"$LegacyUninst" /S --updated /currentuser _?=$LegacyDir' $0
  DetailPrint "旧版卸载程序返回 $0"
  Delete "$LegacyUninst"
  DeleteRegKey HKCU "${LEGACY_KEY}"
  ; 旧版遗留的开始菜单快捷方式（新版放在 FurinaKit 文件夹里）
  Delete "$SMPROGRAMS\FurinaKit.lnk"
  ; 与新版装在同一目录时，把旧版 Electron 的残留清掉（新版文件随后写入）
  ${If} ${FileExists} "$LegacyDir\resources\app\package.json"
  ${OrIf} ${FileExists} "$LegacyDir\resources\furinakit-worker.exe"
    RMDir /r "$LegacyDir\resources"
    RMDir /r "$LegacyDir\locales"
    Delete "$LegacyDir\*.pak"
    Delete "$LegacyDir\*.bin"
    Delete "$LegacyDir\*.dat"
    Delete "$LegacyDir\LICENSE.electron.txt"
    Delete "$LegacyDir\LICENSES.chromium.html"
    Delete "$LegacyDir\d3dcompiler_47.dll"
    Delete "$LegacyDir\ffmpeg.dll"
    Delete "$LegacyDir\libEGL.dll"
    Delete "$LegacyDir\libGLESv2.dll"
    Delete "$LegacyDir\vk_swiftshader.dll"
    Delete "$LegacyDir\vk_swiftshader_icd.json"
    Delete "$LegacyDir\vulkan-1.dll"
  ${EndIf}
  RMDir "$LegacyDir"
FunctionEnd

; 旧版开了「开机自启」的：把登记项换成新版（名字统一为 FurinaKit）。
; 只处理指向已安装 FurinaKit.exe 的项（开发环境里指向 electron.exe 的不动）。
Function MigrateOneAutostart
  Exch $0
  ReadRegStr $1 HKCU "${RUN_KEY}" $0
  ${If} $1 != ""
    Push $1
    Call LegacyParseUninst
    Pop $2
    StrCpy $3 $2 13 -13
    ${If} $3 == "FurinaKit.exe"
      DeleteRegValue HKCU "${RUN_KEY}" $0
      WriteRegStr HKCU "${RUN_KEY}" "FurinaKit" '"$INSTDIR\FurinaKit.exe"'
    ${EndIf}
  ${EndIf}
  Pop $0
FunctionEnd

Function MigrateLegacyAutostart
  Push "furinakit.desktop.app"
  Call MigrateOneAutostart
  Push "com.furinakit.app"
  Call MigrateOneAutostart
FunctionEnd

Function .onInit
  SetShellVarContext current
  ${IfNot} ${RunningX64}
    MessageBox MB_OK|MB_ICONSTOP "FurinaKit 需要 64 位 Windows 系统 (Windows x64)。"
    SetErrorLevel 2
    Abort
  ${EndIf}
  ${IfNot} ${AtLeastWin10}
    MessageBox MB_OK|MB_ICONSTOP "FurinaKit 需要 Windows 10 或 Windows 11。"
    SetErrorLevel 2
    Abort
  ${EndIf}
  Call DetectLegacy
  ReadRegStr $0 HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\furinakit" "InstallLocation"
  ${If} $0 == ""
  ${AndIf} $LegacyDir != ""
  ${AndIf} $LegacyAllUsers == "0"
    StrCpy $INSTDIR $LegacyDir
  ${EndIf}
FunctionEnd

Function EnsureNotRunning
check_again:
  System::Call 'kernel32::OpenMutexW(i 0x00100000, i 0, w "furinakit-single-instance-normal") p.r0'
  ${If} $0 != 0
    System::Call 'kernel32::CloseHandle(p r0)'
    MessageBox MB_RETRYCANCEL|MB_ICONEXCLAMATION "FurinaKit 正在运行中。$\r$\n$\r$\n请从系统托盘右键退出 FurinaKit 后点击“重试”；$\r$\n本程序不会强制关闭您的其它软件或未保存任务。" IDRETRY check_again
    SetErrorLevel 2
    Abort
  ${EndIf}
FunctionEnd

Function EnsureWebView2
  SetRegView 64
  ReadRegStr $0 HKLM "SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" "pv"
  ${If} $0 != ""
    Goto webview_ready
  ${EndIf}
  ReadRegStr $0 HKCU "SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" "pv"
  ${If} $0 != ""
    Goto webview_ready
  ${EndIf}
  SetRegView 32
  ReadRegStr $0 HKLM "SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" "pv"
  ${If} $0 != ""
    Goto webview_ready
  ${EndIf}
  ReadRegStr $0 HKCU "SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" "pv"
  ${If} $0 != ""
    Goto webview_ready
  ${EndIf}
  DetailPrint "正在配置 Microsoft WebView2 运行时..."
  InitPluginsDir
  SetOutPath "$PLUGINSDIR"
  File /oname=MicrosoftEdgeWebview2Setup.exe "${WEBVIEW_BOOTSTRAPPER}"
  ExecWait '"$PLUGINSDIR\MicrosoftEdgeWebview2Setup.exe" /silent /install' $0
  ${If} $0 != 0
  ${AndIf} $0 != 3010
    MessageBox MB_OK|MB_ICONSTOP "WebView2 运行时配置失败 ($0)。请检查网络连接或手动安装 Microsoft WebView2 运行时后重试。" /SD IDOK
    SetErrorLevel 3
    Abort
  ${EndIf}
webview_ready:
  SetRegView 32
FunctionEnd

Section "FurinaKit" Main
  Call EnsureNotRunning
  Call EnsureWebView2
  Call RemoveLegacy

  SetOverwrite on
  SetOutPath "$INSTDIR"
  File "${PAYLOAD_DIR}\DIRECTML-LICENSE.txt"
  File "${PAYLOAD_DIR}\DIRECTML-SOURCE.json"
  File "${PAYLOAD_DIR}\DirectML.dll"
  File "${PAYLOAD_DIR}\FurinaKit-runtime.json"
